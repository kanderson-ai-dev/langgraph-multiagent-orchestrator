# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=langgraph-multiagent-orchestrator
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ─── LLM (Supervisor / Researcher / Writer / Reviewer) ───────────────────────
# Leave empty to run fully offline with the deterministic stub client.
OPENAI_API_KEY=
CHAT_MODEL_NAME=gpt-4o-mini

# ─── Web search provider ─────────────────────────────────────────────────────
# auto | tavily | duckduckgo | none
# `auto` uses Tavily when SEARCH_API_KEY is set, else keyless DuckDuckGo.
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5

# ─── Scraper politeness & safety caps ────────────────────────────────────────
SCRAPE_DELAY_SECONDS=1.0         # per-domain politeness delay
SCRAPE_TIMEOUT_SECONDS=15.0
SCRAPE_MAX_BYTES=1048576         # 1 MiB cap per fetched document
SCRAPE_RESPECT_ROBOTS=true
SCRAPE_MAX_CONCURRENCY=5        # in-flight fetch cap (per-domain delay still applies)

# ─── Orchestration bounds ────────────────────────────────────────────────────
MAX_DEBATE_ROUNDS=3              # Writer <-> Reviewer rounds before HITL escalation
MAX_SUB_QUESTIONS=5              # bounds the Researcher's query fan-out
MAX_WORKER_DISPATCHES=3          # per-worker cap before it leaves the Supervisor's catalog

# ─── LangSmith observability (optional) ──────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=langgraph-multiagent-orchestrator

# ─── Auth (optional — leave empty for open local dev) ────────────────────────
JWT_SECRET_KEY=                  # enables JWT auth when set
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
# bcrypt hash of the admin password (generate with `python -c` + bcrypt)
ADMIN_PASSWORD_HASH=

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60         # 0 disables enforcement

# ─── Persistence ─────────────────────────────────────────────────────────────
DATABASE_PATH=data/orchestrator.sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# ─── Cost accounting (USD per 1M tokens) ─────────────────────────────────────
COST_INPUT_PRICE_PER_1M=0.15
COST_OUTPUT_PRICE_PER_1M=0.60
# Hard LLM-spend cap per job when the client doesn't set budget_usd.
# Empty = unlimited.
DEFAULT_JOB_BUDGET_USD=
