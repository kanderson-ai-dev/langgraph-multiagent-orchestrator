# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=langgraph-multiagent-orchestrator
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ─── LLM (Supervisor / Researcher / Writer / Reviewer) ───────────────────────
# Leave empty to run fully offline with the deterministic stub client.
OPENAI_API_KEY=
CHAT_MODEL_NAME=gpt-4o-mini
# LLM-as-judge: a different model than the generator, when available.
JUDGE_MODEL=gpt-4o

# ─── Web search provider ─────────────────────────────────────────────────────
# auto | tavily | duckduckgo | none
# `auto` uses Tavily when SEARCH_API_KEY is set, else keyless DuckDuckGo.
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5

# ─── Scraper politeness & safety caps ────────────────────────────────────────
SCRAPE_DELAY_SECONDS=1.0         # per-domain politeness delay
SCRAPE_TIMEOUT_SECONDS=15.0
SCRAPE_MAX_BYTES=1048576         # 1 MiB cap per fetched document
SCRAPE_RESPECT_ROBOTS=true
SCRAPE_ROBOTS_FAIL_POLICY=deny  # 5xx/timeout on robots.txt: deny (RFC 9309-strict, default) | allow (permissive); 4xx always allows
SCRAPE_MAX_REDIRECTS=3          # each redirect destination is re-vetted (scheme + DNS)
SCRAPE_MAX_CONCURRENCY=5        # in-flight fetch cap (per-domain delay still applies)

# ─── Orchestration bounds ────────────────────────────────────────────────────
MAX_DEBATE_ROUNDS=3              # Writer <-> Reviewer rounds before HITL escalation
SUPERVISOR_MAX_DISPATCHES=25      # hard bound on Supervisor routing steps
PROMPT_EVAL_TIMEOUT_SECONDS=25.0  # per-eval bound for A/B + promotion runs
MAX_SUB_QUESTIONS=5              # bounds the Researcher's query fan-out
MAX_WORKER_DISPATCHES=3          # per-worker cap before it leaves the Supervisor's catalog
HITL_EXPIRY_HOURS=72             # awaiting_review jobs idle longer than this → expired (0 disables)
HITL_SWEEP_INTERVAL_SECONDS=300  # background sweeper cadence

# ─── Latency optimizations (see docs: measured candidates) ──────────────────
REVIEWER_MODEL=                  # optional cheaper/faster model for the Reviewer only
LLM_MAX_TOKENS=                  # cap structured-output tokens; empty = provider default
RESEARCH_SCRAPE_TOP_K=8          # only scrape the top-K ranked unique sources
REVIEW_EARLY_EXIT_SCORE=4.5      # score ≥ this + all citations verified → skip extra round
REVIEWER_CITATION_SHORTCIRCUIT=true  # skip reviewer LLM call when citations already fail
CACHE_ENABLED=true               # per-tenant search/scrape cache (SQLite, day-scoped)
CACHE_TTL_HOURS=24

# ─── Observability backend: langsmith | langfuse | none ─────────────────────
# `langsmith` needs LANGCHAIN_* below; `langfuse` needs the LANGFUSE_* keys;
# `none` (default) disables tracing entirely. When langfuse is selected it
# wins the slot and LangSmith export stays off — never double-traced.
TRACING_PROVIDER=none
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ─── LangSmith observability (optional) ──────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=langgraph-multiagent-orchestrator

# ─── Auth (optional — leave empty for open local dev) ────────────────────────
JWT_SECRET_KEY=                  # enables JWT auth when set
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
# bcrypt hash of the admin password (generate with `python -c` + bcrypt)
ADMIN_PASSWORD_HASH=
# HMAC key that authenticates job audit roots + prompt lifecycle chain
# entries — a DB-only attacker could recompute hashes but not these MACs.
# Empty = hash-only integrity (audit endpoints report "signed": false).
AUDIT_SIGNING_KEY=
# Optional probabilistic second input-screening layer (one cheap model call
# per accepted brief, tracked under role "guardrail"). Off by default;
# never runs on the offline stub.
GUARDRAIL_LLM_SCREEN=false

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60         # 0 disables enforcement
SSE_HEARTBEAT_SECONDS=15.0       # ping interval on idle job streams
SSE_MAX_STREAM_SECONDS=1800.0    # hard lifetime cap per SSE stream

# ─── Horizontal scale (optional) ─────────────────────────────────────────────
# When set, the rate limiter and the SSE event bus switch from in-memory
# to Redis implementations so multiple replicas share limits and any
# replica can stream any job's events. Empty = single-process defaults.
# REDIS_URL=redis://localhost:6379/0

# ─── Persistence ─────────────────────────────────────────────────────────────
DATABASE_PATH=data/orchestrator.sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# ─── Cost accounting (USD per 1M tokens) ─────────────────────────────────────
COST_INPUT_PRICE_PER_1M=0.15
COST_OUTPUT_PRICE_PER_1M=0.60
# Hard LLM-spend cap per job when the client doesn't set budget_usd.
# Empty = unlimited.
DEFAULT_JOB_BUDGET_USD=

# ─── Human-vs-agent comparison (performance dashboard) ───────────────────────
HUMAN_HOURS_PER_REPORT=6.0       # assumed hours for an equivalent human report
HUMAN_HOURLY_USD=75.0            # assumed fully-loaded hourly rate

# ─── Prompt lifecycle ────────────────────────────────────────────────────────
# Max allowed regression vs the promoted prompt on score metrics during
# promotion gating; safety metrics (citation support, convergence, blocked
# rate) never tolerate any regression.
PROMPT_PROMOTION_EPSILON=0.05

# White-label UI (public via GET /api/v1/config/ui)
UI_PRODUCT_NAME=Orchestrator      # product name shown in landing + console
UI_ACCENT_COLOR=#4f7cff           # hex color for buttons/links focus accents
UI_LOGO_URL=                      # optional logo URL (empty = text wordmark)
